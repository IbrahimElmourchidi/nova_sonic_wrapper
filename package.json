{
  "name": "nova-sonic-server",
  "version": "1.0.0",
  "description": "Production-grade Nova Sonic bidirectional streaming server",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "connectAWS": "ssh -i nova_wrapper_key.pem ec2-user@13.61.2.209",
    "startBackend": "pm2 start npm --name 'nova-wrapper' -- start",
    "backEndStartup":"pm2 save && pm2 startup",
    "stopBackend": "pm2 stop nova-wrapper",
    "deleteBackend": "pm2 delete nova-wrapper",
    "deleteAllBackend": "pm2 delete all",
    "refresh":"npm run build && pm2 restart nova-wrapper",
    "showLogs": "pm2 logs nova-wrapper --lines 100"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/credential-provider-node": "^3.600.0",
    "@aws-sdk/credential-providers": "^3.600.0",
    "@smithy/node-http-handler": "^3.0.0",
    "@smithy/types": "^3.0.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "tsyringe": "^4.8.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}